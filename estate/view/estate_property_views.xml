<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Estate Property</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_available': 1}</field>
    </record>

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties" decoration-success="state=='offer_received'"
                decoration-muted="state == 'sold'"
            >
                <field name="name" string="Title" width="30%" />
                <field name="postcode" string="Postcode" width="10%" />
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"
                    width="10%" />
                <field name="bedrooms" string="Bedrooms" width="10%" />
                <field name="living_area" string="Living Area" width="10%" />
                <field name="expected_price" string="Price" width="10%" />
                <field name="selling_price" string="Selling Price" width="10%" />
                <field name="date_availability" string="Available From" width="20%" optional="show" />
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="action_property_sold" type="object" string="Sold"
                        invisible="state == 'sold' or state == 'canceled'" />
                    <button name="action_property_cancel" type="object" string="Cancel"
                        invisible="state == 'sold' or state == 'canceled'" />
                    <field name="state" widget="statusbar"
                        statusbar_visible="new,offer_received,offer_accepted,sold,canceled" />
                </header>
                <sheet>
                    <div>
                        <h1>
                            <field name="name" string="Title" required="1" />

                        </h1>
                        <field name="tag_ids" widget="many2many_tags"
                            options="{'color_field': 'color'}" />
                    </div>
                    <group name="property">
                        <group>
                            <field name="property_type_id" string="Type"
                                options="{'no_create': True, 'no_quick_create': True}" />
                            <field name="postcode" string="Postcode" required="1" />
                            <field name="date_availability" string="Available From" required="1" />
                        </group>
                        <group>
                            <field name="expected_price" string="Price" required="1" />
                            <field name="best_price" string="Best Price" />
                            <field name="selling_price" string="Selling Price" />
                        </group>
                    </group>
                    <notebook>
                        <page name="description" string="Description">
                            <group name="descripito_page">
                                <field name="description" string="Description" />
                                <field name="bedrooms" string="Bedrooms" />
                                <field name="living_area" string="Living Area" />
                                <field name="facades" string="Facades" />
                                <field name="garage" string="Garage" />
                                <field name="garden" string="Garden" />
                                <field name="garden_area" string="Garden Area"
                                    invisible="not garden" />
                                <field name="garden_orientation" string="Garden Orientation"
                                    invisible="not garden" />
                                <field name="total_area" string="Total Area" />
                            </group>
                        </page>
                        <page name="offer" string="Offers">
                            <field name="offer_ids"
                                readonly="state in ('offer_accepted', 'sold', 'canceled')">
                                <list decoration-danger="status == 'refused'"
                                decoration-success="status == 'accepted'">
                                    <field name="price" />
                                    <field name="partner_id" />
                                    <field name="status" />
                                    <button name="action_property_offer_accept" type="object"
                                        string="Accept" icon="fa-check"
                                        invisible="status == 'accepted' or  status == 'refused'"
                                    />
                                    <button name="action_property_offer_reject" type="object"
                                        string="Reject" icon="fa-times"
                                        invisible="status == 'accepted' or status == 'refused'"
                                    />
                                </list>
                            </field>
                        </page>
                        <page name="info" string="Other info">
                            <group name="info_content">
                                <field name="buyer_id" string="Buyer" />
                                <field name="salesperson_id" string="Salesperson" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Buscar propiedades">

                <!-- Búsqueda directa por estos campos -->
                <field name="name" />
                <field name="postcode" />
                <field name="expected_price" />
                <field name="bedrooms" />
                <field name="living_area" filter_domain="[('living_area', '>=', self)]" />
                <field name="facades" />
                <filter name="available" string="Available"
                    domain="[('state','in',['new','offer_received','offer_accepted'])]" />
                <group expand="1" string="Group by">
                    <filter name="group_by_postcode" string="Postcode"
                        context="{'group_by':'postcode'}" />
                </group>

            </search>
        </field>
    </record>

    <record id="view_estate_property_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="property_type_id" group_create="false">
                <!-- Campos necesarios para condiciones -->
                <field name="state"/>
                <field name="best_price"/>
                <field name="selling_price"/>
                <field name="expected_price"/>
                <field name="tag_ids"/>
                <field name="property_type_id"/>
    
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card">
                            <strong><field name="name"/></strong><br/>
                            <span>Expected: <field name="expected_price"/></span><br/>
    
                            <div t-if="record.state.raw_value == 'offer_received'">
                                Best offer: <field name="best_price"/>
                            </div>
    
                            <div t-if="record.state.raw_value == 'offer_accepted'">
                                Sold for: <field name="selling_price"/>
                            </div>
    
                            <div t-if="record.tag_ids.raw_value">
                                <t t-foreach="record.tag_ids.raw_value" t-as="tag">
                                    <span class="badge badge-primary" t-esc="tag[1]" style="margin-right: 4px;"/>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>